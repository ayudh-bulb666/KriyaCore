# Copy this to /home/deploy/kriyacore/.env on the VPS and fill in real values.
# This file is read by systemd (EnvironmentFile=) — keep it out of git,
# permissions 600, owned by the 'deploy' user.
#
#   cp deploy/.env.example .env
#   nano .env
#   chmod 600 .env

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

FLASK_ENV=production

# Local Postgres — same DB/user you create in step 4 of deploy/SETUP.md
DATABASE_URL=postgresql://kriyacore:CHANGE_ME@localhost:5432/kriyacore

# Optional — leave blank to skip. Reminder emails silently no-op until set.
# The sender address must be on a domain you control and have set SPF/DKIM
# for, or the mail lands in spam. noreply@kriyacore.in is the obvious choice
# once kriyacore.in's DNS is configured with whichever provider you use.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@kriyacore.in

# Optional — leave blank to skip Sentry error monitoring.
SENTRY_DSN=

# Optional — leave blank to disable automatic WhatsApp expiry reminders.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# Required once you add the crontab line in deploy/SETUP.md — without this
# set, the /internal/cron/whatsapp-reminders endpoint always returns 403.
CRON_SECRET=

# Optional — leave blank and every WhatsApp send stays logged as
# "queued_no_provider", nothing actually reaches a phone. Set WHATSAPP_PROVIDER=meta
# to send via Meta's WhatsApp Cloud API directly — see deploy/SETUP.md's
# WhatsApp section for how to get these three values from a free Meta for
# Developers test app. (Other providers — Gupshup, Interakt, etc. — aren't
# implemented yet; see app/whatsapp_provider.py.)
WHATSAPP_PROVIDER=meta
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=
# Must match the language your approved template was created in.
WHATSAPP_TEMPLATE_LANG=en_US
