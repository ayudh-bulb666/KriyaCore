# systemd unit for GYMPro — keeps the app running, auto-restarts on crash,
# auto-starts on server boot.
#
# Install:
#   sudo cp deploy/gympro.service /etc/systemd/system/gympro.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gympro
#
# Logs:
#   sudo journalctl -u gympro -f

[Unit]
Description=GYMPro Flask app (Gunicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/gympro
EnvironmentFile=/home/deploy/gympro/.env
ExecStart=/home/deploy/gympro/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --access-logfile - \
    --error-logfile - \
    run:app
Restart=always
RestartSec=5

# Basic hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
